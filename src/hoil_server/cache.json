 "\"Repeat until there is nothing to be sorted\"": "self.value = self.ValueOf('numSorted') != self.ValueOf('numSticks')",
 "\"As long as there are sticks to check\"": "self.value = self.ValueOf('count') < self.ValueOf('numSticks')",
 "\"Store the height of stick at the current count\"": "self.Assign('currentHeight', self.Call('HeightOf', [self.ValueOf('sticks', index=self.ValueOf('count'))]))",
 "\"If the current stick's height is over the threshold but shorter than the smallest we've found so far\"": "self.value = (self.ValueOf('currentHeight') > self.ValueOf('threshold')) and (self.ValueOf('currentHeight') < self.ValueOf('minHeight'))",
 "\"Update the shortest height to be the current one\"": "self.Assign('minHeight', self.ValueOf('currentHeight'))",
 "\"Change the threshold to be the height we got\"": "self.Assign('threshold', self.ValueOf('minHeight'))",
 "\"Lift the gripper up by 0.2\"": "self.Call('MoveBy', [0, 0, 0.2])",
 "\"Store the location of the stick to be sorted now\"": "self.Assign('stickLocation', self.Call('PositionOf', [self.ValueOf('sticks', index=self.ValueOf('count'))]))",
 "\"Grab the stick\"": "self.Call('Grab', [self.ValueOf('sticks', index=self.ValueOf('count'))])"
